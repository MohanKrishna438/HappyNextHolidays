### ==========================
### SAMPLE TRIP SCENARIOS
### ==========================

### Scenario 1: Create family profile for Delhi trip
POST {{baseUrl}}/familyprofile
Content-Type: application/json

{
  "destinationCity": "Delhi",
  "startDate": "2024-12-15T00:00:00",
  "endDate": "2024-12-20T00:00:00",
  "adultsCount": 2,
  "kidsCount": 2,
  "strollerRequired": true,
  "budgetPreference": "Medium",
  "slowTravelMode": false,
  "children": [
    {
      "name": "Aditya",
      "ageInMonths": 24,
      "hasSpecialNeeds": false,
      "dietaryRestrictions": null,
      "napStartTime": "13:00",
      "napEndTime": "15:00"
    },
    {
      "name": "Priya",
      "ageInMonths": 48,
      "hasSpecialNeeds": false,
      "dietaryRestrictions": null,
      "napStartTime": "13:30",
      "napEndTime": "14:30"
    }
  ]
}

