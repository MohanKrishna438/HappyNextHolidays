### Happy Next Holidays - Sample API Requests

@baseUrl = https://localhost:5001/api

### 1. CREATE FAMILY PROFILE
POST {{baseUrl}}/familyprofile
Content-Type: application/json

{
  "destination": "Orlando, Florida",
  "travelStartDate": "2024-07-01T00:00:00",
  "travelEndDate": "2024-07-07T00:00:00",
  "numberOfKids": 2,
  "kidsAges": [2, 4],
  "napStartTime": "13:00",
  "napEndTime": "15:00",
  "hasStroller": true,
  "budgetPreference": "Medium"
}

### 2. GET FAMILY PROFILE
GET {{baseUrl}}/familyprofile/1

### 3. UPDATE FAMILY PROFILE
PUT {{baseUrl}}/familyprofile/1
Content-Type: application/json

{
  "destination": "Orlando, Florida",
  "travelStartDate": "2024-07-01T00:00:00",
  "travelEndDate": "2024-07-08T00:00:00",
  "numberOfKids": 2,
  "kidsAges": [2, 4],
  "napStartTime": "13:00",
  "napEndTime": "15:00",
  "hasStroller": true,
  "budgetPreference": "High"
}

### 4. GENERATE ITINERARY
POST {{baseUrl}}/itinerary/generate/1

### 5. GET GENERATED ITINERARY
GET {{baseUrl}}/itinerary/family/1

### 6. GENERATE PACKING CHECKLIST
POST {{baseUrl}}/packingchecklist/generate/1

### 7. GET PACKING CHECKLIST
GET {{baseUrl}}/packingchecklist/family/1

### 8. UPDATE CHECKLIST ITEM (Mark as packed)
PUT {{baseUrl}}/packingchecklist/1/item/1
Content-Type: application/json

{
  "id": 1,
  "itemName": "Diapers",
  "category": "Hygiene",
  "quantity": 16,
  "isPacked": true,
  "notes": "Pack of 80 count"
}

### 9. GET SAFETY MAP FOR DESTINATION
GET {{baseUrl}}/safetymap/destination/Orlando%2C%20Florida

### 10. GET HOSPITALS ONLY
GET {{baseUrl}}/safetymap/Orlando%2C%20Florida/Hospital

### 11. GET RESTAURANTS ONLY
GET {{baseUrl}}/safetymap/Orlando%2C%20Florida/Restaurant

### 12. GET PHARMACIES ONLY
GET {{baseUrl}}/safetymap/Orlando%2C%20Florida/Pharmacy

### 13. GET PARKS ONLY
GET {{baseUrl}}/safetymap/Orlando%2C%20Florida/Park

### 14. ADD NEW SAFETY LOCATION
POST {{baseUrl}}/safetymap
Content-Type: application/json

{
  "destination": "Orlando, Florida",
  "infoType": "Hospital",
  "name": "Florida Hospital Orlando",
  "address": "7727 Lake Ellenor Drive, Orlando, FL 32809",
  "phoneNumber": "(321) 841-5000",
  "latitude": 28.4465,
  "longitude": -81.3269,
  "notes": "Pediatric emergency department available",
  "isVerified": true
}

### 15. DELETE ITINERARY
DELETE {{baseUrl}}/itinerary/family/1

### 16. DELETE PACKING CHECKLIST
DELETE {{baseUrl}}/packingchecklist/1

### 17. DELETE FAMILY PROFILE
DELETE {{baseUrl}}/familyprofile/1

### Notes:
# - Use %2C for comma in URL parameters (URL encoding)
# - Dates should be in ISO 8601 format
# - Times should be in HH:mm format
# - Testing example with New York:
#   Destination: "New York, New York"
# - Testing example with Los Angeles:
#   Destination: "Los Angeles, California"
